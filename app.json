{
  "expo": {
    "name": "GameTOK",
    "slug": "gametok",
    "scheme": "gametok",
    "version": "2.1.5",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.olasubomi.gametok",
      "buildNumber": "57",
      "associatedDomains": [
        "applinks:gametok.co"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "GameTOK needs access to your photo library so you can choose a profile picture to personalize your account and help friends recognize you.",
        "NSMicrophoneUsageDescription": "GameTOK uses your microphone for voice chat in multiplayer games."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.vogeza",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 57
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/with-ios-audio-session",
      [
        "expo-av",
        {
          "microphonePermission": "GameTOK uses your microphone for voice chat in multiplayer games."
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.690098564284-704g6n4d0ur6audbsgqnd2tnkfranatc"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GameTOK needs access to your photo library so you can choose a profile picture to personalize your account and help friends recognize you."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/graphik_arabic.otf",
            "./assets/fonts/graphik_arabic_bold.otf",
            "./assets/fonts/graphik_arabic_medium.otf",
            "./assets/fonts/graphik_arabic_semibold.otf"
          ]
        }
      ],
      "expo-image",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#000000"
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a8a4606e-1211-4011-ab35-08afb8194d9d"
      }
    }
  }
}
